{
	"name": "obsidian-sidebar-calendar",
	"version": "0.1.0",
	"description": "Monthly calendar in the sidebar for the schedule in your daily notes, with multi-day bars, to-dos, and dragging to add or move entries.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --import tsx --test tests/*.test.ts"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
